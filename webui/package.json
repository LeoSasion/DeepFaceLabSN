{
  "name": "webui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --configLoader runner",
    "dev:server": "node server/index.mjs",
    "build": "vite build --configLoader runner && node scripts/prepare-sites-build.mjs",
    "start": "node server/index.mjs",
    "serve:local": "node scripts/local-manager.mjs start",
    "stop:local": "node scripts/local-manager.mjs stop",
    "restart:local": "node scripts/local-manager.mjs restart",
    "status:local": "node scripts/local-manager.mjs status",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node --test tests/browser-e2e.mjs",
    "test:e2e:mutating": "set DFL_E2E_MUTATING=1&& node --test tests/browser-e2e.mjs",
    "smoke:live": "node scripts/smoke-live.mjs",
    "preview": "vite preview --configLoader runner",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@tabler/icons-react": "3.35.0",
    "@vitejs/plugin-react": "5.0.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "3.7.0",
    "vite": "6.4.3",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "playwright": "1.61.1"
  }
}
